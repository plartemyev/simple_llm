# syntax=docker/dockerfile:1
#
# Arch Linux-based image serving an OpenAI-compatible LLM endpoint via
# llama.cpp (llama-server), CUDA backend.
#
# Toolkit: the current Arch `cuda` package (13.x) from the repos — no
# pinning, matching the current NVIDIA drivers (>= 580 required by CUDA 13)
# hosts run from the same repos. Driver coupling stays out of the image:
# the host driver's libcuda.so is injected at runtime by the nvidia
# container runtime; only the toolkit's runtime libraries (libcudart.so.13,
# libcublas*) are baked in. Binaries carry explicit sm_XX SASS (CUDA_ARCH
# build-arg below) so loads never depend on PTX JIT.
# nvcc 13.x supports host GCC up to 16.x (CUDA 13.x Installation Guide,
# Table 3). Defensive check: nvcc rejects host compilers above the ceiling
# compiled into /opt/cuda/include/crt/host_config.h — the build fails fast
# with a clear message if Arch's gcc moves past it before the toolkit does.

FROM archlinux:base-devel AS build

RUN pacman-key --init \
 && pacman -Syu --noconfirm \
      git cmake ninja curl wget python cuda

# Defensive check (see header): nvcc's compiled-in host-compiler ceiling
# must still accept the system gcc Arch ships.
ARG EXPECTED_NVCC_GCC_LIMIT=16

RUN nvcc_limit="$(grep -m1 -oP '(?<=#if __GNUC__ > )\d+' /opt/cuda/include/crt/host_config.h || true)" \
 && if [ "${nvcc_limit}" != "${EXPECTED_NVCC_GCC_LIMIT}" ]; then \
      echo "ERROR: nvcc host-compiler ceiling is '${nvcc_limit}', expected '${EXPECTED_NVCC_GCC_LIMIT}'. Pin a compatible gcc or bump the expectation." >&2; \
      exit 1; \
    fi

# Arch installs the toolkit under /opt/cuda; make nvcc visible to CMake
ENV PATH="/opt/cuda/bin:${PATH}"

# GPU compute capability to compile SASS for (RTX 3090 = 86). Space-separated
# list, e.g. "86;89;120" for mixed fleets.
ARG CUDA_ARCH=86

# --- llama.cpp -----------------------------------------------------------------
ARG LLAMA_CPP_REF=v0.7.0

RUN git clone --depth 1 --branch "${LLAMA_CPP_REF}" https://github.com/ggml-org/llama.cpp /src/llama.cpp \
 && cmake -S /src/llama.cpp -B /src/llama.cpp/build \
      -DCMAKE_BUILD_TYPE=Release \
      -DGGML_CUDA=ON \
      -DCMAKE_CUDA_ARCHITECTURES="${CUDA_ARCH}" \
      -DLLAMA_CURL=ON \
      -DGGML_NATIVE=OFF \
 && cmake --build /src/llama.cpp/build --config Release -j"$(nproc)" \
      --target llama-server llama-cli

# --- runtime -------------------------------------------------------------------
FROM archlinux:base-devel AS runtime

RUN pacman-key --init \
 && pacman -Syu --noconfirm python python-pip curl \
 && python -m venv /opt/venv \
 && /opt/venv/bin/pip install --no-cache-dir "openai>=3,<4" "pytest>=9"

# llama-server/llama-cli plus all companion shared libraries (libllama*.so,
# ggml backends) produced next to the binaries, and the CUDA runtime
# libraries from the toolkit (the driver's libcuda.so comes from the host
# via the nvidia container runtime).
COPY --from=build /src/llama.cpp/build/bin/ /app/bin/
COPY --from=build /opt/cuda/lib64/libcudart.so.13* /app/cudalib/
COPY --from=build /opt/cuda/lib64/libcublas.so.13* /app/cudalib/
COPY --from=build /opt/cuda/lib64/libcublasLt.so.13* /app/cudalib/
ENV LD_LIBRARY_PATH=/app/bin:/app/cudalib

# repository: client, benchmarks, tests (usable inside the container)
COPY . /app

ENV PATH="/app/bin:/opt/venv/bin:${PATH}" \
    HOME=/data/cache
RUN mkdir -p /data/cache /models
WORKDIR /app
EXPOSE 8011
ENTRYPOINT ["/app/docker/entrypoint.sh"]
