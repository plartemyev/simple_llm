# syntax=docker/dockerfile:1
#
# Arch Linux-based image serving an OpenAI-compatible LLM endpoint via
# llama.cpp (llama-server), CUDA backend.
#
# Toolkit pinning rationale:
#   - Current Arch `cuda` is 13.x, which requires driver >= 580. GPU hosts
#     running the 570 driver series (CUDA 12.8 generation) cannot run
#     CUDA 13 binaries, so the toolkit is pinned to the newest 12.x release
#     in the Arch Linux Archive: cuda 12.9.1-2.
#   - CUDA *minor version compatibility* guarantees that applications built
#     against any CUDA 12.x toolkit run on any R525+ driver, provided the
#     binaries carry SASS for the target GPU (no PTX JIT). We compile
#     explicit sm_XX cubins via CMAKE_CUDA_ARCHITECTURES below.
#   - nvcc 12.9 supports host GCC up to 14.x (see Table 2 of the CUDA
#     12.9 Installation Guide); gcc14 comes from the current repos.

FROM archlinux:base-devel AS build

RUN pacman-key --init \
 && pacman -Syu --noconfirm \
      git cmake ninja curl wget python gcc14

# --- CUDA toolkit from the Arch Linux Archive ---------------------------------
ARG CUDA_PKG_URL=https://archive.archlinux.org/packages/c/cuda/cuda-12.9.1-2-x86_64.pkg.tar.zst
# Defensive check: nvcc rejects host compilers above the ceiling compiled into
# /opt/cuda/include/crt/host_config.h. Fail the build with a clear message if
# the pin changes and the expectation no longer holds.
ARG EXPECTED_NVCC_GCC_LIMIT=14
# GPU compute capability to compile SASS for (RTX 3090 = 86). Space-separated
# list, e.g. "86;89;120" for mixed fleets.
ARG CUDA_ARCH=86

RUN curl -fsSL -o /tmp/cuda.pkg.tar.zst "${CUDA_PKG_URL}" \
 && pacman -U --noconfirm --assume-installed nvidia-utils=9999 /tmp/cuda.pkg.tar.zst \
 && rm /tmp/cuda.pkg.tar.zst \
 && nvcc_limit="$(grep -m1 -oP '(?<=#if __GNUC__ > )\d+' /opt/cuda/include/crt/host_config.h || true)" \
 && if [ "${nvcc_limit}" != "${EXPECTED_NVCC_GCC_LIMIT}" ]; then \
      echo "ERROR: nvcc host-compiler ceiling is '${nvcc_limit}', expected '${EXPECTED_NVCC_GCC_LIMIT}'. Adjust the gcc pin." >&2; \
      exit 1; \
    fi

# --- llama.cpp -----------------------------------------------------------------
ARG LLAMA_CPP_REF=v0.6.0

RUN git clone --depth 1 --branch "${LLAMA_CPP_REF}" https://github.com/ggml-org/llama.cpp /src/llama.cpp \
 && cmake -S /src/llama.cpp -B /src/llama.cpp/build \
      -DCMAKE_BUILD_TYPE=Release \
      -DGGML_CUDA=ON \
      -DCMAKE_CUDA_ARCHITECTURES="${CUDA_ARCH}" \
      -DCMAKE_CUDA_HOST_COMPILER=/usr/bin/gcc-14 \
      -DCMAKE_C_COMPILER=/usr/bin/gcc-14 \
      -DCMAKE_CXX_COMPILER=/usr/bin/g++-14 \
      -DLLAMA_CURL=ON \
      -DGGML_NATIVE=OFF \
 && cmake --build /src/llama.cpp/build --config Release -j"$(nproc)" \
      --target llama-server llama-cli

# --- runtime -------------------------------------------------------------------
FROM archlinux:base-devel AS runtime

RUN pacman-key --init \
 && pacman -Syu --noconfirm python python-pip curl \
 && python -m venv /opt/venv \
 && /opt/venv/bin/pip install --no-cache-dir "openai>=1.60,<3" "pytest>=8"

# llama-server/llama-cli plus the CUDA runtime libraries they need at run time
# (the driver's libcuda.so comes from the host via the nvidia container runtime).
COPY --from=build /src/llama.cpp/build/bin/llama-server /app/bin/llama-server
COPY --from=build /src/llama.cpp/build/bin/llama-cli /app/bin/llama-cli
COPY --from=build /opt/cuda/lib64/libcudart.so.12* /app/cudalib/
COPY --from=build /opt/cuda/lib64/libcublas.so.12* /app/cudalib/
COPY --from=build /opt/cuda/lib64/libcublasLt.so.12* /app/cudalib/
ENV LD_LIBRARY_PATH=/app/cudalib

# repository: client, benchmarks, tests (usable inside the container)
COPY . /app

ENV PATH="/app/bin:/opt/venv/bin:${PATH}" \
    HOME=/data/cache
RUN mkdir -p /data/cache /models
WORKDIR /app
EXPOSE 8011
ENTRYPOINT ["/app/docker/entrypoint.sh"]
